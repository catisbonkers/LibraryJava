<%-- borrow-modal.jspf
     Renders: DaisyUI dialog for borrowing a book, asking for the number of days.
     Requires: SettingsService import in the parent JSP if you want to show the penalty rule dynamically,
     or we can just import it here.
--%>
<%@ page import="com.example.demo1.service.SettingsService" %>

<dialog id="borrowModal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box glass-panel max-w-sm">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2 bg-primary/10 rounded-xl">
                <i data-lucide="book-down" class="w-6 h-6 text-primary"></i>
            </div>
            <div>
                <h3 class="font-bold text-xl">Borrow Book</h3>
            </div>
        </div>
        <p class="text-base-content/80 mb-2">You are about to borrow:</p>
        <p id="borrowModalTitle" class="font-bold text-lg text-primary mb-6 line-clamp-2"></p>

        <form action="${pageContext.request.contextPath}/borrow" method="post" class="flex flex-col gap-4">
            <input type="hidden" id="borrowBookId" name="bookId" />

            <div class="form-control w-full">
                <label class="label">
                    <span class="label-text font-medium">Borrow Duration (Days)</span>
                </label>
                <input type="number" name="daysBorrowed" min="1" max="30" value="7" class="input input-bordered w-full" required />
                <label class="label">
                    <span class="label-text-alt text-base-content/60">Max 30 days.</span>
                </label>
            </div>

            <div class="alert alert-warning shadow-sm mt-2 text-sm p-3">
                <i data-lucide="info" class="w-4 h-4"></i>
                <span>Overdue penalty is <strong>$<%= String.format("%.2f", SettingsService.getPenaltyPerDay()) %> per day</strong>.</span>
            </div>

            <div class="modal-action mt-4">
                <button type="button" class="btn btn-ghost gap-2" onclick="document.getElementById('borrowModal').close()">
                    <i data-lucide="x" class="w-4 h-4"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary gap-2">
                    <i data-lucide="check" class="w-4 h-4"></i> Confirm Borrow
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<script>
    function openBorrowModal(bookId, title) {
        document.getElementById('borrowBookId').value = bookId;
        document.getElementById('borrowModalTitle').textContent = '"' + title + '"';
        document.getElementById('borrowModal').showModal();
    }
</script>
